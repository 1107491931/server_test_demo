# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS specific
.DS_Store
.AppleDouble
.LSOverride

# Logs
*.log
logs/

# Database files
*.db
*.sqlite
*.sqlite3
# 允许根目录 dbs 下的数据库文件（如果需要）
!dbs/*.db
!dbs/**/*.db
# 忽略服务目录下的数据库文件
services/*/dbs/**/*.db

# Docker
.dockerignore
docker-compose.override.yml

# Build artifacts
*.bin
# 服务二进制文件（在服务目录下）
services/*/user-service
services/*/post-service

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Security
# *.pem
# *.key
# *.pub
